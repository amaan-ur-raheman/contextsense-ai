# Python-generated files
__pycache__/
*.py[cod]
*bak
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/
env/

# uv
.uv/

# NOTE: .python-version is intentionally tracked. It pins the interpreter for
# uv, and without it a fresh clone resolves to the system Python, where
# gensim 4.4.0 fails to build on 3.13+.

# IDE</path>
.vscode/
.idea/
*.swp
*.swo

# Data and models (large files, not for version control)
data/raw/
data/processed/*.bin
data/processed/*.gz
data/*.bin
data/*.gz
# Pre-trained Word2Vec vectors (3.6 GB). The patterns above are anchored to
# data/ and so do not reach into subdirectories -- without this line the
# vectors file would be committable.
data/word2vec/
!data/sample_examples.json
!data/README.md
!data/.gitkeep
!data/processed/.gitkeep

artifacts/
.cache/

# NLTK data
.nltk_data/

# Cache directories
~/.cache/contextsense/

# Environment files
.env
.env.local

# Logs
*.log

# Streamlit
.streamlit/secrets.toml

# Downloaded benchmark corpora and large derived datasets (see
# `uv run python -m contextsense_ai.datasets.semcor` to regenerate)
data/raw/*
!data/raw/.gitkeep
data/datasets/*
!data/datasets/.gitkeep

presentation-guide.md

# Agent tooling installed into the working tree (skills, prompts)
.agents/
.claude/

# Local teaching workspace. Personal study material, not part of the
# library: open lessons/index.html in a browser to use it. Nothing here
# is needed to run, test, or evaluate the project.
lessons/
reference/
assets/
learning-records/
MISSION.md
NOTES.md
RESOURCES.md
