# ContextSense AI - Environment Configuration
# Reference for the variables Settings reads. Export them in your shell before
# starting the app; the project does not parse a .env file itself.
# Relative directory values resolve against the project root, not the shell CWD.

# Data directories (relative to project root)
DATA_DIR=data
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
ARTIFACTS_DIR=artifacts
CACHE_DIR=~/.cache/contextsense_ai

# NLTK configuration
NLTK_DATA_DIR=~/.nltk_data
NLTK_DOWNLOAD_TIMEOUT=300

# Default embedding model
DEFAULT_EMBEDDING_BACKEND=sentence_transformer
DEFAULT_SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
DEFAULT_WORD2VEC_MODEL=GoogleNews-vectors-negative300.bin.gz

# Context extraction defaults
DEFAULT_CONTEXT_WINDOW=5
MIN_CONTEXT_WINDOW=1
MAX_CONTEXT_WINDOW=20

# Random seed for reproducibility
RANDOM_SEED=42
